.DS_Store
__pycache__/
*.pyc
.pytest_cache/
*.pdf
!coding-resource/*.pdf

# Context Preservation System — session-specific runtime data
.claude/context-snapshots/

# D-1: Workflow runtime directories (generated during workflow execution)
verification-logs/
autopilot-logs/
pacs-logs/
review-logs/
diagnosis-logs/
.traces/
translations/*
!translations/glossary.yaml

# TDD Guard toggle — personal workflow setting (not shared)
.tdd-guard

# Setup Hook logs — runtime diagnostics (regenerated on each run)
.claude/hooks/*.log

# Distribution archives & build artifacts
*.zip
*.tar.gz
*.tgz
*.egg-info/
dist/
build/
release-assets/
*.backup.*

# Node / Bun
node_modules/
bun.lockb
package-lock.json
yarn.lock
pnpm-lock.yaml

# Security
.env*
!*.example

# System engine runtime records
.notifications.json
.announcements_seen.json
.update_history.json
.migration_history.json
ledger.jsonl
.fable/

# Local installation targets (installed by AutoInstaller / test suites)
.gemini/config/skills/
.claude/skills/agentic-workflow/
.cursor/skills/

